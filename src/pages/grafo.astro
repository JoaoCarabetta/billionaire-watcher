---
// No server-side data fetching - the page reads the static JSON client-side
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grafo de Controle - Billionaire Watcher</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
        color: #333;
        padding: 1rem;
      }
      
      h1 {
        font-size: 2rem;
        margin-bottom: 1rem;
        color: #1a1a1a;
        text-align: center;
      }
      
      a {
        color: #0066cc;
        text-decoration: none;
      }
      
      a:hover {
        text-decoration: underline;
      }
      
      .back-link {
        margin-bottom: 1rem;
        display: block;
      }
      
      .grafo-stage {
        position: relative;
      }

      #cy {
        width: 100%;
        height: 80vh;
        border: 1px solid #ddd;
        background: #fafafa;
      }

      #panel {
        position: absolute;
        top: 0;
        right: 0;
        width: min(360px, 92vw);
        height: 80vh;
        overflow: auto;
        background: #fff;
        border: 1px solid #ddd;
        border-left: 1px solid #ccc;
        padding: 1rem;
        z-index: 2;
      }

      #panel[hidden] {
        display: none;
      }

      .grafo-panel-body h2 {
        font-size: 1.1rem;
        margin-bottom: 0.75rem;
      }

      .grafo-panel-body h3 {
        font-size: 0.95rem;
        margin: 1rem 0 0.4rem;
      }

      .grafo-panel-body p {
        margin: 0.25rem 0;
        font-size: 0.9rem;
      }

      .grafo-panel-field {
        color: #666;
        font-size: 0.8rem;
        text-transform: none;
      }

      .grafo-panel-body ul {
        list-style: none;
        padding: 0;
      }

      .grafo-panel-body li {
        margin-bottom: 0.75rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid #eee;
      }

      .info {
        text-align: center;
        margin: 1rem 0;
        color: #666;
        font-size: 0.9rem;
      }

      .info a {
        font-weight: 500;
      }

      .grafo-search {
        position: relative;
        max-width: 28rem;
        margin: 0 auto 1rem;
        z-index: 3;
      }

      .grafo-search label {
        display: block;
        font-size: 0.9rem;
        color: #333;
        margin-bottom: 0.35rem;
      }

      .grafo-search input {
        width: 100%;
        padding: 0.5rem 0.75rem;
        font-size: 1rem;
        border: 1px solid #ccc;
        border-radius: 4px;
      }

      #grafo-search-results {
        list-style: none;
        margin-top: 0.25rem;
        padding: 0;
        border: 1px solid #ddd;
        background: #fff;
        max-height: 16rem;
        overflow: auto;
      }

      #grafo-search-results[hidden],
      #grafo-search-empty[hidden] {
        display: none;
      }

      #grafo-search-results button {
        display: block;
        width: 100%;
        text-align: left;
        padding: 0.5rem 0.75rem;
        border: 0;
        background: transparent;
        cursor: pointer;
        font-size: 0.9rem;
      }

      #grafo-search-results button:hover,
      #grafo-search-results button:focus {
        background: #f0f4f8;
      }

      #grafo-search-empty {
        margin-top: 0.35rem;
        font-size: 0.9rem;
        color: #666;
      }
    </style>
  </head>
  <body>
    <a href="/" class="back-link">← Voltar</a>
    
    <header>
      <h1>Grafo de Controle Corporativo</h1>
    </header>

    <main>
      <div class="info">
        <p>529 nós, 670 arestas | Dados: <a href="/grafo-publico.json">grafo-publico.json</a></p>
      </div>
      <div class="grafo-search">
        <label for="grafo-search">Buscar pessoa ou empresa</label>
        <input id="grafo-search" type="search" autocomplete="off" spellcheck="false">
        <ul id="grafo-search-results" hidden></ul>
        <p id="grafo-search-empty" hidden>Nenhuma pessoa ou empresa neste grafo.</p>
      </div>
      <div class="grafo-stage">
        <div id="cy"></div>
        <aside id="panel" hidden></aside>
      </div>
    </main>

    <script type="module">
      import cytoscape from 'cytoscape';
      import { buildCytoscapeElements } from '../lib/grafo-elements';
      import { buildPanelView, renderPanelHtml } from '../lib/grafo-panel';
      import { searchGrafoNodes } from '../lib/grafo-search';

      const panel = document.getElementById('panel');
      const searchInput = document.getElementById('grafo-search');
      const searchResults = document.getElementById('grafo-search-results');
      const searchEmpty = document.getElementById('grafo-search-empty');

      function showPanel(view) {
        if (!panel) {
          return;
        }
        const html = renderPanelHtml(view);
        panel.innerHTML = html;
        panel.hidden = html === '';
      }

      // Fetch the static JSON (graph + cited person money; no server)
      Promise.all([
        fetch('/grafo-publico.json').then(response => response.json()),
        fetch('/grafo-dinheiro.json').then(response => response.json()),
      ])
        .then(([data, money]) => {
          // Transform nodes and edges to Cytoscape format using shared function
          const elements = buildCytoscapeElements(data);

          // Initialize Cytoscape
          const cy = cytoscape({
            container: document.getElementById('cy'),
            elements: elements,
            style: [
              {
                selector: 'node',
                style: {
                  'label': 'data(label)',
                  'text-valign': 'center',
                  'text-halign': 'center',
                  'font-size': '10px',
                  'width': '30px',
                  'height': '30px',
                  'text-wrap': 'wrap',
                  'text-max-width': '80px'
                }
              },
              {
                selector: 'node[kind="person"]',
                style: {
                  'background-color': '#3498db',
                  'color': '#333'
                }
              },
              {
                selector: 'node[kind="company"]',
                style: {
                  'background-color': '#e74c3c',
                  'color': '#333'
                }
              },
              {
                selector: 'node[kind="company"][listed]',
                style: {
                  'background-color': '#16a085',
                  'color': '#333'
                }
              },
              {
                selector: 'edge',
                style: {
                  'width': 2,
                  'line-color': '#95a5a6',
                  'target-arrow-color': '#95a5a6',
                  'target-arrow-shape': 'triangle',
                  'curve-style': 'bezier',
                  'label': 'data(label)',
                  'font-size': '8px',
                  'text-rotation': 'autorotate',
                  'text-margin-y': -10
                }
              }
            ],
            layout: {
              name: 'cose',
              animate: false,
              nodeRepulsion: 8000,
              idealEdgeLength: 100,
              edgeElasticity: 100,
              nestingFactor: 1.2,
              gravity: 1,
              numIter: 1000,
              initialTemp: 1000,
              coolingFactor: 0.99,
              minTemp: 1.0
            }
          });

          function openNodePanel(nodeId) {
            showPanel(buildPanelView(data, { nodeId }, money));
          }

          function hideSearchList() {
            if (searchResults) {
              searchResults.hidden = true;
              searchResults.replaceChildren();
            }
            if (searchEmpty) {
              searchEmpty.hidden = true;
            }
          }

          function renderSearchHits(hits) {
            if (!searchResults || !searchEmpty) {
              return;
            }
            searchResults.replaceChildren();
            if (hits.length === 0) {
              searchResults.hidden = true;
              searchEmpty.hidden = false;
              return;
            }
            searchEmpty.hidden = true;
            for (const hit of hits) {
              const item = document.createElement('li');
              const button = document.createElement('button');
              button.type = 'button';
              button.dataset.nodeId = hit.id;
              button.textContent = hit.label;
              item.appendChild(button);
              searchResults.appendChild(item);
            }
            searchResults.hidden = false;
          }

          function selectSearchHit(nodeId) {
            openNodePanel(nodeId);
            const ele = cy.getElementById(nodeId);
            if (ele.nonempty()) {
              cy.fit(ele, 80);
            }
          }

          cy.on('tap', 'node', function (evt) {
            openNodePanel(evt.target.id());
          });

          cy.on('tap', 'edge', function (evt) {
            showPanel(buildPanelView(data, {
              from: evt.target.data('source'),
              to: evt.target.data('target')
            }, money));
          });

          cy.on('tap', function (evt) {
            if (evt.target === cy) {
              showPanel(null);
            }
          });

          if (searchInput) {
            searchInput.addEventListener('input', function () {
              const query = searchInput.value;
              if (!query.trim()) {
                hideSearchList();
                return;
              }
              renderSearchHits(searchGrafoNodes(data.nodes, query));
            });

            searchInput.addEventListener('keydown', function (evt) {
              if (evt.key !== 'Enter') {
                return;
              }
              evt.preventDefault();
              const hits = searchGrafoNodes(data.nodes, searchInput.value);
              if (hits[0]) {
                selectSearchHit(hits[0].id);
              }
            });
          }

          if (searchResults) {
            searchResults.addEventListener('click', function (evt) {
              const button = evt.target.closest('button[data-node-id]');
              if (!button) {
                return;
              }
              selectSearchHit(button.dataset.nodeId);
            });
          }
        })
        .catch(error => {
          console.error('Erro ao carregar o grafo:', error);
          document.getElementById('cy').innerHTML = 
            '<div style="padding: 2rem; text-align: center; color: #666;">Erro ao carregar o grafo. Verifique o console.</div>';
        });
    </script>
  </body>
</html>
