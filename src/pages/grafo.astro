---
// No server-side data fetching - the page reads the static JSON client-side
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grafo de Controle - Billionaire Watcher</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
        color: #333;
        padding: 1rem;
      }
      
      h1 {
        font-size: 2rem;
        margin-bottom: 1rem;
        color: #1a1a1a;
        text-align: center;
      }
      
      a {
        color: #0066cc;
        text-decoration: none;
      }
      
      a:hover {
        text-decoration: underline;
      }
      
      .back-link {
        margin-bottom: 1rem;
        display: block;
      }
      
      #cy {
        width: 100%;
        height: 80vh;
        border: 1px solid #ddd;
        background: #fafafa;
      }

      .info {
        text-align: center;
        margin: 1rem 0;
        color: #666;
        font-size: 0.9rem;
      }

      .info a {
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <a href="/" class="back-link">← Voltar</a>
    
    <header>
      <h1>Grafo de Controle Corporativo</h1>
    </header>

    <main>
      <div class="info">
        <p>95 nós, 44 arestas | Dados: <a href="/grafo-publico.json">grafo-publico.json</a></p>
      </div>
      <div id="cy"></div>
    </main>

    <script type="module">
      import cytoscape from 'cytoscape';
      import { buildCytoscapeElements } from '../lib/grafo-elements';

      // Fetch the static JSON
      fetch('/grafo-publico.json')
        .then(response => response.json())
        .then(data => {
          // Transform nodes and edges to Cytoscape format using shared function
          const elements = buildCytoscapeElements(data);

          // Initialize Cytoscape
          const cy = cytoscape({
            container: document.getElementById('cy'),
            elements: elements,
            style: [
              {
                selector: 'node',
                style: {
                  'label': 'data(label)',
                  'text-valign': 'center',
                  'text-halign': 'center',
                  'font-size': '10px',
                  'width': '30px',
                  'height': '30px',
                  'text-wrap': 'wrap',
                  'text-max-width': '80px'
                }
              },
              {
                selector: 'node[kind="person"]',
                style: {
                  'background-color': '#3498db',
                  'color': '#333'
                }
              },
              {
                selector: 'node[kind="company"]',
                style: {
                  'background-color': '#e74c3c',
                  'color': '#333'
                }
              },
              {
                selector: 'edge',
                style: {
                  'width': 2,
                  'line-color': '#95a5a6',
                  'target-arrow-color': '#95a5a6',
                  'target-arrow-shape': 'triangle',
                  'curve-style': 'bezier',
                  'label': 'data(label)',
                  'font-size': '8px',
                  'text-rotation': 'autorotate',
                  'text-margin-y': -10
                }
              }
            ],
            layout: {
              name: 'cose',
              animate: false,
              nodeRepulsion: 8000,
              idealEdgeLength: 100,
              edgeElasticity: 100,
              nestingFactor: 1.2,
              gravity: 1,
              numIter: 1000,
              initialTemp: 1000,
              coolingFactor: 0.99,
              minTemp: 1.0
            }
          });
        })
        .catch(error => {
          console.error('Erro ao carregar o grafo:', error);
          document.getElementById('cy').innerHTML = 
            '<div style="padding: 2rem; text-align: center; color: #666;">Erro ao carregar o grafo. Verifique o console.</div>';
        });
    </script>
  </body>
</html>
