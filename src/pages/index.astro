---
import { getFreeze, getIdentityFactsByPersonId, getRFPartnerEdgesByPersonId } from '../utils/fixtures';
import type { Source } from '../types';
import PageTools from '../components/PageTools.astro';
import { mintCitedEmpresas } from '../lib/mint-empresa';
import { loadPublicGrafo, mintCitedPessoas } from '../lib/mint-pessoa';
import {
  INDICE_EMPTY_GRAFO_ONLY,
  INDICE_EMPTY_NOT_IN_ARCHIVE,
  type MintedFicha,
} from '../lib/indice-search';

const freezePersons = getFreeze();
const grafo = loadPublicGrafo();
const mintedFichas: MintedFicha[] = [];
const mintedIds = new Set<string>();
for (const pessoa of mintCitedPessoas(grafo)) {
  mintedFichas.push({ id: pessoa.id, label: pessoa.name, kind: 'person' });
  mintedIds.add(pessoa.id);
}
for (const empresa of mintCitedEmpresas(grafo)) {
  mintedFichas.push({ id: empresa.id, label: empresa.legal_name, kind: 'company' });
  mintedIds.add(empresa.id);
}
for (const person of freezePersons) {
  if (mintedIds.has(person.person_id)) {
    continue;
  }
  mintedFichas.push({
    id: person.person_id,
    label: person.person_name,
    kind: 'person',
  });
}
const mintedJson = JSON.stringify(mintedFichas);

// Build citation map for facts shown on home
const citationMap = new Map<string, number>();
let nextCitationNumber = 1;

// Collect sample facts from each person (for 500+ char requirement)
interface PersonFact {
  personId: string;
  personName: string;
  facts: Array<{ value: string; source: Source }>;
}

const personFacts: PersonFact[] = [];

for (const person of freezePersons) {
  const identityFacts = getIdentityFactsByPersonId(person.person_id);
  const rfEdges = getRFPartnerEdgesByPersonId(person.person_id);
  
  const facts: Array<{ value: string; source: Source }> = [];
  
  // Add role fact
  const roleFact = identityFacts.find(f => f.field === 'role');
  if (roleFact && roleFact.source) {
    facts.push({ value: roleFact.value, source: roleFact.source });
    if (!citationMap.has(roleFact.source.locator)) {
      citationMap.set(roleFact.source.locator, nextCitationNumber++);
    }
  }
  
  // Add company fact
  const companyFact = identityFacts.find(f => f.field === 'group_name');
  if (companyFact && companyFact.source) {
    facts.push({ value: companyFact.value, source: companyFact.source });
    if (!citationMap.has(companyFact.source.locator)) {
      citationMap.set(companyFact.source.locator, nextCitationNumber++);
    }
  }
  
  // Add RF edges
  for (const rfEdge of rfEdges) {
    if (rfEdge.source) {
      facts.push({ 
        value: `${rfEdge.relationship} de ${rfEdge.company_name}`, 
        source: rfEdge.source 
      });
      if (!citationMap.has(rfEdge.source.locator)) {
        citationMap.set(rfEdge.source.locator, nextCitationNumber++);
      }
    }
  }
  
  if (facts.length > 0) {
    personFacts.push({
      personId: person.person_id,
      personName: person.person_name,
      facts
    });
  }
}

// Build unique sources list
const allSources = personFacts.flatMap(pf => pf.facts.map(f => f.source));
const uniqueSources = Array.from(citationMap.entries())
  .map(([locator, num]) => {
    const source = allSources.find(s => s && s.locator === locator);
    return { num, source };
  })
  .filter(entry => entry.source)
  .sort((a, b) => a.num - b.num);

const getCitationNumber = (source: Source | undefined) => {
  if (!source || !source.locator) return 0;
  return citationMap.get(source.locator) || 0;
};
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Billionaire Watcher - Arquivo Cívico de Poder Econômico</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
      }
      
      h1 {
        font-size: 2rem;
        margin-bottom: 2rem;
        color: #1a1a1a;
      }
      
      section {
        margin: 2rem 0;
      }
      
      section h2 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
        color: #1a1a1a;
      }
      
      a {
        color: #0066cc;
        text-decoration: none;
      }
      
      a:hover {
        text-decoration: underline;
      }
      
      .person-list {
        list-style: none;
        padding: 0;
      }
      
      .person-list li {
        padding: 0.75rem;
        margin-bottom: 0.5rem;
        background-color: #f8f9fa;
        border-left: 3px solid #0066cc;
        border-radius: 2px;
      }
      
      .person-list a {
        font-weight: 600;
        font-size: 1.1rem;
      }
      
      .citation-marker {
        color: #0066cc;
        font-weight: bold;
        margin-left: 0.1em;
      }

      .indice-search {
        position: relative;
        margin: 0 0 1rem;
      }

      .indice-search label {
        display: block;
        font-size: 0.9rem;
        color: #333;
        margin-bottom: 0.35rem;
      }

      .indice-search input {
        width: 100%;
        padding: 0.5rem 0.75rem;
        font-size: 1rem;
        border: 1px solid #ccc;
        border-radius: 4px;
      }

      #indice-search-results {
        list-style: none;
        margin-top: 0.25rem;
        padding: 0;
        border: 1px solid #ddd;
        background: #fff;
      }

      #indice-search-results[hidden],
      #indice-search-grafo-only[hidden],
      #indice-search-empty[hidden] {
        display: none;
      }

      #indice-search-results a,
      #indice-search-results span {
        display: block;
        padding: 0.5rem 0.75rem;
        font-size: 0.9rem;
      }

      #indice-search-grafo-only,
      #indice-search-empty {
        margin-top: 0.35rem;
        font-size: 0.9rem;
        color: #666;
      }

      .indice-tools {
        margin-top: 0.75rem;
        font-size: 0.95rem;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Billionaire Watcher</h1>
    </header>

    <main>
      <section>
        <p>Arquivo cívico. Fatos citados de fontes públicas.</p>
      </section>

      <section>
        <div class="indice-search">
          <label for="indice-search">Buscar pessoa ou empresa</label>
          <input id="indice-search" type="search" autocomplete="off" spellcheck="false">
          <ul id="indice-search-results" hidden></ul>
          <p id="indice-search-grafo-only" hidden>{INDICE_EMPTY_GRAFO_ONLY}</p>
          <p id="indice-search-empty" hidden>{INDICE_EMPTY_NOT_IN_ARCHIVE}</p>
        </div>
        <p class="indice-tools">
          <a href="/metodologia/">Metodologia</a>
          {' · '}
          <a href="/grafo/">Grafo</a>
        </p>
      </section>
      
      <section>
        <h2>Pessoas</h2>
        {freezePersons.length === 0 ? (
          <p>Nenhuma pessoa no índice.</p>
        ) : (
          <ul class="person-list">
            {personFacts.map(pf => (
              <li>
                <strong>
                  <a href={`/pessoa/${pf.personId}`}>
                    {pf.personName}
                  </a>
                </strong>
                {' — '}
                {pf.facts.map((fact, idx) => (
                  <span>
                    {idx > 0 && '; '}
                    {fact.value}
                    <sup class="citation-marker">[{getCitationNumber(fact.source)}]</sup>
                  </span>
                ))}
              </li>
            ))}
            {freezePersons.filter(p => !personFacts.find(pf => pf.personId === p.person_id)).map(person => (
              <li>
                <a href={`/pessoa/${person.person_id}`}>
                  {person.person_name}
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>

      {uniqueSources.length > 0 && (
        <section>
          <h2>Referências</h2>
          <ol style="font-size: 0.9rem; line-height: 1.6;">
            {uniqueSources.map(({ num, source }) => (
              <li id={`citation-${num}`}>
                <strong>{source!.publisher}</strong>
                {' — '}
                {source!.locator}
                {source!.retrieved_at && (
                  <span style="color: #666; font-size: 0.85em;">
                    {' '}(recuperado em {source!.retrieved_at})
                  </span>
                )}
              </li>
            ))}
          </ol>
        </section>
      )}

      <section>
        <h2>Doações Políticas</h2>
        <p>
          <a href="/doacoes">Ver tabela completa de doações políticas →</a>
        </p>
      </section>

      <footer style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid #ddd;">
        <p>
          <a href="/metodologia">Metodologia →</a>
        </p>
      </footer>
    </main>
    <script type="application/json" id="indice-minted" set:html={mintedJson} />
    <script>
      import { classifyIndiceQuery } from '../lib/indice-search';

      const searchInput = document.getElementById('indice-search');
      const searchResults = document.getElementById('indice-search-results');
      const grafoOnlyEmpty = document.getElementById('indice-search-grafo-only');
      const archiveEmpty = document.getElementById('indice-search-empty');
      const mintedEl = document.getElementById('indice-minted');
      const minted = mintedEl ? JSON.parse(mintedEl.textContent || '[]') : [];

      function hideSearch() {
        if (searchResults) {
          searchResults.hidden = true;
          searchResults.replaceChildren();
        }
        if (grafoOnlyEmpty) grafoOnlyEmpty.hidden = true;
        if (archiveEmpty) archiveEmpty.hidden = true;
      }

      function renderResult(result) {
        if (!searchResults || !grafoOnlyEmpty || !archiveEmpty) {
          return;
        }
        if (result.kind === 'empty') {
          hideSearch();
          return;
        }
        if (result.kind === 'not_in_archive') {
          searchResults.hidden = true;
          searchResults.replaceChildren();
          grafoOnlyEmpty.hidden = true;
          archiveEmpty.hidden = false;
          return;
        }
        archiveEmpty.hidden = true;
        grafoOnlyEmpty.hidden = result.kind !== 'grafo_only';
        searchResults.replaceChildren();
        for (const hit of result.hits) {
          const item = document.createElement('li');
          if (hit.href) {
            const link = document.createElement('a');
            link.href = hit.href;
            link.textContent = hit.label;
            item.appendChild(link);
          } else {
            const span = document.createElement('span');
            span.textContent = hit.label;
            item.appendChild(span);
          }
          searchResults.appendChild(item);
        }
        searchResults.hidden = result.hits.length === 0;
      }

      fetch('/grafo-publico.json')
        .then((response) => response.json())
        .then((data) => {
          if (!searchInput) {
            return;
          }
          searchInput.addEventListener('input', function () {
            renderResult(classifyIndiceQuery(searchInput.value, data.nodes, minted));
          });
          searchInput.addEventListener('keydown', function (evt) {
            if (evt.key !== 'Enter') {
              return;
            }
            evt.preventDefault();
            const result = classifyIndiceQuery(searchInput.value, data.nodes, minted);
            if (result.kind === 'ficha' && result.href) {
              window.location.assign(result.href);
            } else {
              renderResult(result);
            }
          });
        });
    </script>
    <PageTools />
  </body>
</html>
