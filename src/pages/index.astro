---
import { getFreeze } from '../utils/fixtures';

const freezePersons = getFreeze();
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Billionaire Watcher - Arquivo Cívico de Poder Econômico</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
      }
      
      h1 {
        font-size: 2rem;
        margin-bottom: 2rem;
        color: #1a1a1a;
      }
      
      section {
        margin: 2rem 0;
      }
      
      section h2 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
        color: #1a1a1a;
      }
      
      a {
        color: #0066cc;
        text-decoration: none;
      }
      
      a:hover {
        text-decoration: underline;
      }
      
      .person-list {
        list-style: none;
        padding: 0;
      }
      
      .person-list li {
        padding: 0.75rem;
        margin-bottom: 0.5rem;
        background-color: #f8f9fa;
        border-left: 3px solid #0066cc;
        border-radius: 2px;
      }
      
      .person-list a {
        font-weight: 600;
        font-size: 1.1rem;
      }
      
      .person-meta {
        color: #666;
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Billionaire Watcher</h1>
    </header>

    <main>
      <section>
        <h2>Pessoas no Índice Congelado</h2>
        {freezePersons.length === 0 ? (
          <p>Nenhuma pessoa no índice.</p>
        ) : (
          <ul class="person-list">
            {freezePersons.map(person => (
              <li>
                <a href={`/pessoa/${person.person_id}`}>
                  {person.person_name}
                </a>
                <span class="person-meta">
                  {' — '}{person.role} na {person.group_name}
                </span>
              </li>
            ))}
          </ul>
        )}
      </section>
    </main>
  </body>
</html>
