---
import FactWithCitation from '../components/FactWithCitation.astro';
import Citations from '../components/Citations.astro';
import { getMethodologyFacts } from '../utils/fixtures';
import type { Source, Fact } from '../types';

const allFacts = getMethodologyFacts();

// Build citation map: unique sources by first appearance
const citationMap = new Map<string, number>();
let nextCitationNumber = 1;

const allSources = allFacts.filter(f => f.source).map(f => f.source!);

for (const source of allSources) {
  if (!citationMap.has(source.locator)) {
    citationMap.set(source.locator, nextCitationNumber++);
  }
}

const getCitationNumber = (source: Source) => citationMap.get(source.locator)!;

// Helper to get fact by id
const getFactById = (id: string): Fact | undefined => allFacts.find(f => f.id === id);

// Organize facts by section using ids
const rankingFacts = [
  getFactById('metod-ranking-source')
].filter(Boolean) as Fact[];

const positionalDoorFacts = [
  getFactById('metod-positional-door'),
  getFactById('metod-positional-method'),
  getFactById('metod-fre-listed'),
  getFactById('metod-qsa-unlisted'),
  getFactById('metod-qsa-socio-label'),
  getFactById('metod-qsa-no-beneficiario'),
  getFactById('metod-visible-hole')
].filter(Boolean) as Fact[];

const scopeFacts = [
  getFactById('metod-soe-skip-pf'),
  getFactById('metod-soe-no-ceo'),
  getFactById('metod-foreign-ceo-not-controller'),
  getFactById('metod-foreign-included')
].filter(Boolean) as Fact[];

const forbesFacts = [
  getFactById('metod-forbes-safety-net')
].filter(Boolean) as Fact[];

const protocolDateFacts = [
  getFactById('metod-protocol-date')
].filter(Boolean) as Fact[];

const rejectedMethodsFacts = [
  getFactById('metod-reject-interlocks'),
  getFactById('metod-reject-wikipedia-forbes'),
  getFactById('metod-reject-tse-volume')
].filter(Boolean) as Fact[];

const dataAccessFacts = [
  getFactById('metod-published-facts-index')
].filter(Boolean) as Fact[];
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Metodologia - Billionaire Watcher</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
      }
      
      h1 {
        font-size: 2rem;
        margin-bottom: 2rem;
        color: #1a1a1a;
      }
      
      section {
        margin: 2rem 0;
      }
      
      section h2 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
        color: #1a1a1a;
      }
      
      a {
        color: #0066cc;
        text-decoration: none;
      }
      
      a:hover {
        text-decoration: underline;
      }
      
      .back-link {
        margin-bottom: 2rem;
        display: block;
      }
      
      .methodology-content {
        margin: 2rem 0;
      }
      
      .fact {
        margin: 1rem 0;
      }
    </style>
  </head>
  <body>
    <a href="/" class="back-link">← Voltar</a>
    
    <header>
      <h1>Metodologia</h1>
    </header>

    <main>
      <section class="methodology-content">
        <h2>Critério de Inclusão</h2>
        {rankingFacts.map((fact) => (
          <FactWithCitation fact={fact} citationNumber={getCitationNumber(fact.source!)} />
        ))}
      </section>

      <section class="methodology-content">
        <h2>Porta de Entrada para Pessoas Físicas</h2>
        {positionalDoorFacts.map((fact) => (
          <FactWithCitation fact={fact} citationNumber={getCitationNumber(fact.source!)} />
        ))}
      </section>

      <section class="methodology-content">
        <h2>Escopo: Empresas Estatais e Estrangeiras</h2>
        {scopeFacts.map((fact) => (
          <FactWithCitation fact={fact} citationNumber={getCitationNumber(fact.source!)} />
        ))}
      </section>

      <section class="methodology-content">
        <h2>Rede de Segurança</h2>
        {forbesFacts.map((fact) => (
          <FactWithCitation fact={fact} citationNumber={getCitationNumber(fact.source!)} />
        ))}
      </section>

      <section class="methodology-content">
        <h2>Data de Referência</h2>
        {protocolDateFacts.map((fact) => (
          <FactWithCitation fact={fact} citationNumber={getCitationNumber(fact.source!)} />
        ))}
      </section>

      <section class="methodology-content">
        <h2>Métodos Rejeitados</h2>
        {rejectedMethodsFacts.map((fact) => (
          <FactWithCitation fact={fact} citationNumber={getCitationNumber(fact.source!)} />
        ))}
      </section>

      <section class="methodology-content">
        <h2>Acesso aos Dados</h2>
        {dataAccessFacts.map((fact) => (
          <FactWithCitation fact={fact} citationNumber={getCitationNumber(fact.source!)} />
        ))}
        <p style="margin-top: 1rem; color: #666;">
          Arquivos por pessoa: <code>/api/facts/latest/{'{'}slug{'}'}.json</code> e <code>/api/facts/latest/{'{'}slug{'}'}.jsonl</code>
        </p>
      </section>

      <Citations citationMap={citationMap} allSources={allSources} />
    </main>
  </body>
</html>
