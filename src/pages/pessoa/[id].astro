---
import FactWithCitation from '../../components/FactWithCitation.astro';
import Citations from '../../components/Citations.astro';
import { getFreeze, getIdentityFactsByPersonId } from '../../utils/fixtures';
import type { Person } from '../../types';

export async function getStaticPaths() {
  const freezePersons = getFreeze();
  
  return freezePersons.map(person => ({
    params: { id: person.person_id },
    props: { person }
  }));
}

interface Props {
  person: Person;
}

const { person } = Astro.props;
const identityFacts = getIdentityFactsByPersonId(person.person_id);
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{person.person_name} - Billionaire Watcher</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
      }
      
      h1 {
        font-size: 2rem;
        margin-bottom: 2rem;
        color: #1a1a1a;
      }
      
      section {
        margin: 2rem 0;
      }
      
      section h2 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
        color: #1a1a1a;
      }
      
      a {
        color: #0066cc;
        text-decoration: none;
      }
      
      a:hover {
        text-decoration: underline;
      }
      
      .back-link {
        display: inline-block;
        margin-bottom: 1rem;
        font-size: 0.9rem;
      }
      
      .person-info {
        background-color: #f8f9fa;
        padding: 1rem;
        border-radius: 4px;
        margin-bottom: 2rem;
      }
      
      .person-info p {
        margin: 0.5rem 0;
      }
    </style>
  </head>
  <body>
    <a href="/" class="back-link">← Voltar para o índice</a>
    
    <header>
      <h1>{person.person_name}</h1>
    </header>

    <main>
      <div class="person-info">
        <p><strong>Grupo:</strong> {person.group_name}</p>
        <p><strong>Papel:</strong> {person.role}</p>
      </div>

      {identityFacts.length > 0 && (
        <section>
          <h2>Dados de Identidade</h2>
          {identityFacts.map((fact, index) => (
            <FactWithCitation fact={fact} citationNumber={index + 1} />
          ))}
        </section>
      )}

      <Citations facts={identityFacts} />
    </main>
  </body>
</html>
