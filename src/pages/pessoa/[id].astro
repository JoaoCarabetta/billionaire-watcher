---
import FactWithCitation from '../../components/FactWithCitation.astro';
import RFPartnerEdge from '../../components/RFPartnerEdge.astro';
import CVMFREControl from '../../components/CVMFREControl.astro';
import DerivedAssociation from '../../components/DerivedAssociation.astro';
import Citations from '../../components/Citations.astro';
import { 
  getFreeze, 
  getIdentityFactsByPersonId,
  getRFPartnerEdgesByPersonId,
  getCVMFREControlsByPersonId,
  getDonationsByPersonId,
  getDerivedAssociationsByPersonId,
  getCandidateByCpf,
  formatCurrency,
  redactCPF,
  shouldUsePublishedFacts
} from '../../utils/fixtures';
import type { Person, Source } from '../../types';

export async function getStaticPaths() {
  const freezePersons = getFreeze();
  
  return freezePersons.map(person => ({
    params: { id: person.person_id },
    props: { person }
  }));
}

interface Props {
  person: Person;
}

const { person } = Astro.props;
const identityFacts = getIdentityFactsByPersonId(person.person_id);
const rfPartnerEdges = getRFPartnerEdgesByPersonId(person.person_id);
const cvmFreControls = getCVMFREControlsByPersonId(person.person_id);
const donations = getDonationsByPersonId(person.person_id);
const associations = getDerivedAssociationsByPersonId(person.person_id);

// Find name fact for title, or fallback to freeze CSV name as index chrome
const nameFact = identityFacts.find(f => f.field === 'nome');
const pageTitle = nameFact ? nameFact.value : person.person_name;

// Get CPF for JSON-LD (masked format)
// Both identity facts and freeze CSV cpf need redaction for old fixtures
const cpfFromFacts = identityFacts.find(f => f.cpf)?.cpf;
const cpfForJsonLd = cpfFromFacts ? redactCPF(cpfFromFacts) : (person.cpf ? redactCPF(person.cpf) : null);

// Build citation map: unique sources by first appearance, numbered sequentially
const citationMap = new Map<string, number>();
let nextCitationNumber = 1;

// Collect all sources in order of appearance
const allSources: Source[] = [
  ...identityFacts.filter(f => f.source).map(f => f.source!),
  ...rfPartnerEdges.filter(e => e.source).map(e => e.source),
  ...cvmFreControls.filter(c => c.source).map(c => c.source),
  ...donations.map(d => d.source),
  ...associations.filter(a => a.source).map(a => a.source!)
];

// Assign numbers to unique sources by first appearance
for (const source of allSources) {
  if (!citationMap.has(source.locator)) {
    citationMap.set(source.locator, nextCitationNumber++);
  }
}

// Helper to get citation number for a source
const getCitationNumber = (source: Source) => citationMap.get(source.locator)!;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{pageTitle} - Billionaire Watcher</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": pageTitle,
      "url": `https://billionaire-watcher.pages.dev/pessoa/${person.person_id}/`,
      ...(cpfForJsonLd ? { "taxID": cpfForJsonLd } : {})
    })} />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
      }
      
      h1 {
        font-size: 2rem;
        margin-bottom: 2rem;
        color: #1a1a1a;
      }
      
      section {
        margin: 2rem 0;
      }
      
      section h2 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
        color: #1a1a1a;
      }
      
      a {
        color: #0066cc;
        text-decoration: none;
      }
      
      a:hover {
        text-decoration: underline;
      }
      
      .back-link {
        display: inline-block;
        margin-bottom: 1rem;
        font-size: 0.9rem;
      }
      
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 0.5rem;
      }
      
      th {
        text-align: left;
        padding: 0.5rem;
        background: #f8f9fa;
        font-weight: 600;
        border-bottom: 2px solid #ddd;
      }
      
      .missing-control {
        padding: 1rem;
        background: #fff3cd;
        border-left: 3px solid #ffc107;
        color: #856404;
        margin-top: 0.5rem;
      }
      
      .donations-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      
      .donation-item {
        padding: 1rem;
        background-color: #f8f9fa;
        border-left: 3px solid #28a745;
        border-radius: 2px;
      }
      
      .donation-vehicle {
        font-size: 0.9rem;
        color: #666;
        margin-bottom: 0.5rem;
      }
      
      .donation-details {
        font-size: 1rem;
      }
      
      .donation-amount {
        font-weight: 600;
        color: #28a745;
      }
      
      .donation-cycle {
        font-size: 0.9rem;
        color: #666;
      }
      
      .citation-marker {
        color: #0066cc;
        font-weight: bold;
        margin-left: 0.1em;
      }
    </style>
  </head>
  <body>
    <a href="/" class="back-link">← Voltar para o índice</a>
    
    <header>
      <h1>{pageTitle}</h1>
    </header>

    <main>
      {identityFacts.length > 0 && (
        <section>
          <h2>Dados de Identidade</h2>
          {identityFacts.map((fact) => (
            <FactWithCitation fact={fact} citationNumber={getCitationNumber(fact.source!)} />
          ))}
          {/* Show CPF if any identity fact has it OR if person has cpf from freeze.csv */}
          {(identityFacts.some(f => f.cpf) || person.cpf) && (
            <div class="fact cpf-fact">
              <span class="fact-value">CPF: {redactCPF(identityFacts.find(f => f.cpf)?.cpf || person.cpf || '')}</span>
            </div>
          )}
        </section>
      )}

      {rfPartnerEdges.length > 0 && (
        <section>
          <h2>Empresas e Sócios</h2>
          <table>
            <thead>
              <tr>
                <th>Empresa</th>
                <th>Relação</th>
              </tr>
            </thead>
            <tbody>
              {rfPartnerEdges.map((edge) => (
                <RFPartnerEdge edge={edge} citationNumber={getCitationNumber(edge.source)} />
              ))}
            </tbody>
          </table>
        </section>
      )}

      {cvmFreControls.length > 0 && (
        <section>
          <h2>Controle Acionário (CVM)</h2>
          {cvmFreControls.map((control) => (
            <CVMFREControl control={control} citationNumber={getCitationNumber(control.source)} />
          ))}
        </section>
      )}

      {/* Show CVM hole only when RF edges exist but no CVM controls */}
      {rfPartnerEdges.length > 0 && cvmFreControls.length === 0 && (
        <section>
          <h2>Controle Acionário</h2>
          <div class="missing-control">
            Informações sobre controle acionário não identificadas nos registros públicos da CVM (Formulário de Referência).
          </div>
        </section>
      )}

      {donations.length > 0 && (
        <section>
          <h2>Doações Políticas</h2>
          <div class="donations-list">
            {donations.map((donation) => {
              const candidate = getCandidateByCpf(donation.candidate_cpf);
              const citationNumber = getCitationNumber(donation.source);
              
              return (
                <div class="donation-item">
                  {donation.donor_type === 'cnpj' && (
                    <p class="donation-vehicle">
                      Via: <strong>{donation.donor_name}</strong>
                    </p>
                  )}
                  <p class="donation-details">
                    <span class="donation-amount">{formatCurrency(donation.amount)}</span>
                    {' para '}
                    {candidate?.in_freeze && candidate.person_id ? (
                      <a href={`/pessoa/${candidate.person_id}`}>{redactCPF(donation.candidate_name)}</a>
                    ) : candidate?.wikipedia_url ? (
                      <a href={candidate.wikipedia_url} target="_blank" rel="noopener noreferrer">{redactCPF(donation.candidate_name)}</a>
                    ) : candidate?.tse_url ? (
                      <a href={candidate.tse_url} target="_blank" rel="noopener noreferrer">{redactCPF(donation.candidate_name)}</a>
                    ) : (
                      <span>{redactCPF(donation.candidate_name)}</span>
                    )}
                    {' '}
                    <span class="donation-cycle">({donation.cycle})</span>
                    <sup class="citation-marker">[{citationNumber}]</sup>
                  </p>
                </div>
              );
            })}
          </div>
        </section>
      )}

      {associations.length > 0 && (
        <section>
          <h2>Associações</h2>
          {associations.map((association) => (
            <DerivedAssociation association={association} citationMap={citationMap} />
          ))}
        </section>
      )}

      <Citations citationMap={citationMap} allSources={allSources} />
      
      <footer style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid #ddd;">
        <p>
          <a href="/metodologia">Metodologia →</a>
        </p>
      </footer>
    </main>
  </body>
</html>
