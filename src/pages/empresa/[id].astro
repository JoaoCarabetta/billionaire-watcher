---
import { loadPublicGrafo } from '../../lib/mint-pessoa';
import {
  mintCitedEmpresas,
  renderEmpresaFichaHtml,
  type CitedEmpresa,
} from '../../lib/mint-empresa';

export async function getStaticPaths() {
  const minted = mintCitedEmpresas(loadPublicGrafo());
  return minted.map((ficha) => ({
    params: { id: ficha.id },
    props: { ficha },
  }));
}

interface Props {
  ficha: CitedEmpresa;
}

const { ficha } = Astro.props;
return new Response(renderEmpresaFichaHtml(ficha), {
  headers: { 'Content-Type': 'text/html; charset=utf-8' },
});
---
