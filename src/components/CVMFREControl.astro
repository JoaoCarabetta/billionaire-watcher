---
import type { CVMFREControl } from '../types';

interface Props {
  control: CVMFREControl;
  citationNumber: number;
}

const { control, citationNumber } = Astro.props;

if (!control.source) {
  throw new Error(`CVM FRE control ${control.id} is missing a source and cannot be rendered`);
}
---

<div class="fre-control" data-control-id={control.id}>
  <div class="control-row">
    <span class="control-label">{control.control_type}:</span>
    <span class="control-description">{control.control_description}</span>
    <sup class="citation-marker">[{citationNumber}]</sup>
  </div>
</div>

<style>
  .fre-control {
    margin: 0.75rem 0;
    padding: 0.75rem;
    background: #f8f9fa;
    border-left: 3px solid #0066cc;
  }
  
  .control-row {
    line-height: 1.6;
  }
  
  .control-label {
    font-weight: 600;
    color: #1a1a1a;
    margin-right: 0.5em;
  }
  
  .control-description {
    color: #333;
  }
  
  .citation-marker {
    color: #0066cc;
    font-weight: bold;
    margin-left: 0.1em;
  }
</style>
