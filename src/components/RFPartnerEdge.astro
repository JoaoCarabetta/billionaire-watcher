---
import type { RFPartnerEdge } from '../types';

interface Props {
  edge: RFPartnerEdge;
  citationNumber: number;
}

const { edge, citationNumber } = Astro.props;

if (!edge.source) {
  throw new Error(`RF edge ${edge.id} is missing a source and cannot be rendered`);
}
---

<tr class="rf-edge" data-edge-id={edge.id}>
  <td class="company-name">{edge.company_name}</td>
  <td class="relationship">{edge.relationship}<sup class="citation-marker">[{citationNumber}]</sup></td>
</tr>

<style>
  .rf-edge td {
    padding: 0.5rem;
    border-bottom: 1px solid #e0e0e0;
  }
  
  .company-name {
    font-weight: 500;
  }
  
  .relationship {
    color: #555;
  }
  
  .citation-marker {
    color: #0066cc;
    font-weight: bold;
    margin-left: 0.1em;
  }
</style>
