---
import type { DerivedAssociation, Fact } from '../types';
import { getFactById } from '../utils/fixtures';

interface Props {
  association: DerivedAssociation;
  factsStartIndex: number;
}

const { association, factsStartIndex } = Astro.props;

const parentFacts = association.parent_facts
  .map(id => getFactById(id))
  .filter((f): f is Fact => f !== undefined);

if (parentFacts.length === 0) {
  throw new Error(`Derived association ${association.id} has no valid parent facts`);
}

const citationNumbers = association.parent_facts.map((factId, idx) => {
  const allFacts = parentFacts;
  const factIndex = allFacts.findIndex(f => f.id === factId);
  return factIndex !== -1 ? factsStartIndex + factIndex + 1 : null;
}).filter((n): n is number => n !== null);
---

<div class="derived-association" data-association-id={association.id}>
  <p class="association-description">
    {association.description}
    {citationNumbers.map((num, idx) => (
      <sup class="citation-marker">
        [{num}]{idx < citationNumbers.length - 1 ? ',' : ''}
      </sup>
    ))}
  </p>
</div>

<style>
  .derived-association {
    margin: 1rem 0;
    padding: 0.75rem;
    background-color: #f8f9fa;
    border-left: 3px solid #0066cc;
  }
  
  .association-description {
    margin: 0;
  }
  
  .citation-marker {
    color: #0066cc;
    font-weight: bold;
    margin-left: 0.1em;
  }
</style>
