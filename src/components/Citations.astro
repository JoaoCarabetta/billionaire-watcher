---
import type { Source } from '../types';

interface Props {
  citationMap: Map<string, number>;
  allSources: Source[];
}

const { citationMap, allSources } = Astro.props;

// Build a map of locator -> source for quick lookup
const sourceByLocator = new Map<string, Source>();
for (const source of allSources) {
  if (!sourceByLocator.has(source.locator)) {
    sourceByLocator.set(source.locator, source);
  }
}

// Sort entries by citation number
const sortedCitations = Array.from(citationMap.entries())
  .sort((a, b) => a[1] - b[1]);
---

{citationMap.size > 0 && (
  <section class="citations">
    <h2>Referências</h2>
    <ol>
      {sortedCitations.map(([locator, number]) => {
        const source = sourceByLocator.get(locator)!;
        return (
          <li id={`citation-${number}`}>
            <strong>{source.publisher}</strong>
            {' — '}
            <a href={source.locator} target="_blank" rel="noopener noreferrer">
              {source.locator}
            </a>
            {' '}
            <span class="retrieved">(recuperado em {source.retrieved_at})</span>
          </li>
        );
      })}
    </ol>
  </section>
)}

<style>
  .citations {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #ddd;
  }
  
  .citations h2 {
    font-size: 1.2rem;
    margin-bottom: 1rem;
  }
  
  .citations ol {
    font-size: 0.9rem;
    line-height: 1.6;
  }
  
  .citations li {
    margin-bottom: 0.5rem;
  }
  
  .retrieved {
    color: #666;
    font-size: 0.85em;
  }
</style>
