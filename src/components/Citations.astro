---
import type { Source } from '../types';

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;

const uniqueSources = sources.filter((source, index, self) =>
  index === self.findIndex((s) => s.locator === source.locator)
);
---

{uniqueSources.length > 0 && (
  <section class="citations">
    <h2>Referências</h2>
    <ol>
      {uniqueSources.map((source, index) => (
        <li id={`citation-${index + 1}`}>
          <strong>{source.publisher}</strong>
          {' — '}
          <a href={source.locator} target="_blank" rel="noopener noreferrer">
            {source.locator}
          </a>
          {' '}
          <span class="retrieved">(recuperado em {source.retrieved_at})</span>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .citations {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #ddd;
  }
  
  .citations h2 {
    font-size: 1.2rem;
    margin-bottom: 1rem;
  }
  
  .citations ol {
    font-size: 0.9rem;
    line-height: 1.6;
  }
  
  .citations li {
    margin-bottom: 0.5rem;
  }
  
  .retrieved {
    color: #666;
    font-size: 0.85em;
  }
</style>
